@model IEnumerable<QLCCCC.Models.CuDan>

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Danh Sách Cư Dân - QLCCCC</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        body {
            background: linear-gradient(to right, #e0f7fa, #b2ebf2); /* Gradient xanh dương nhạt */
            font-family: 'Arial', sans-serif;
            color: #00796b; /* Màu xanh dương đậm cho chữ toàn trang */
        }

        .container {
            margin-top: 30px;
            max-width: 1200px;
        }

        .header-title {
            text-align: center;
            font-size: 2.5rem;
            font-weight: 700;
            color: #0288d1; /* Xanh dương đậm sáng */
            margin-bottom: 25px;
            text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.05); /* Bóng chữ nhẹ */
        }

        .table-container {
            background: #fff;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.03); /* Bóng đổ nhẹ */
            transition: box-shadow 0.3s ease;
        }

            .table-container:hover {
                box-shadow: 0 6px 14px rgba(0, 0, 0, 0.05); /* Bóng đổ tăng khi hover */
            }

        .btn-create {
            display: inline-block;
            margin-bottom: 20px;
            padding: 10px 25px;
            font-size: 1rem;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(135deg, #0288d1, #01579b); /* Gradient xanh dương sáng */
            border: none;
            border-radius: 5px;
            transition: all 0.3s ease;
        }

            .btn-create:hover {
                background: linear-gradient(135deg, #01579b, #0277bd); /* Gradient đậm hơn khi hover */
                text-decoration: none;
                color: #fff;
                transform: translateY(-2px);
                box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
            }

        .table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0;
            background-color: #fff;
            border: 1px solid #b2ebf2; /* Viền xanh dương nhạt đồng bộ với nền */
            border-radius: 8px;
            overflow: hidden;
        }

            .table thead th {
                background: linear-gradient(135deg, #81d4fa, #0288d1); /* Gradient xanh dương nhạt */
                color: #fff;
                font-weight: 600;
                padding: 15px;
                text-align: left;
                border-bottom: 2px solid #01579b; /* Viền dưới xanh dương đậm */
            }

            .table tbody td {
                padding: 15px;
                font-size: 1rem;
                color: #00796b; /* Màu xanh dương nhạt */
                border-bottom: 1px solid #b2ebf2;
                background-color: #ffffff; /* Nền trắng */
                transition: background-color 0.3s ease;
            }

            .table tbody tr:last-child td {
                border-bottom: none;
            }

            .table tbody tr:hover td {
                background-color: #e1f5fe; /* Nền hover xanh dương nhạt rất nhẹ */
            }

        .action-links a {
            margin-right: 10px;
            font-size: 0.9rem;
            text-decoration: none;
            transition: color 0.3s ease, transform 0.3s ease;
        }

            .action-links a.edit {
                color: #81c784; /* Xanh lá sáng */
            }

                .action-links a.edit:hover {
                    color: #66bb6a; /* Xanh lá đậm hơn khi hover */
                    transform: translateY(-2px);
                }

            .action-links a.delete {
                color: #d32f2f; /* Đỏ đậm */
            }

                .action-links a.delete:hover {
                    color: #e57373; /* Đỏ sáng hơn khi hover */
                    transform: translateY(-2px);
                }
    </style>

</head>
<body>
    @if (TempData["ErrorMessage"] != null)
    {
        <div id="errorMessage" class="alert alert-danger alert-dismissible fade show mt-3 shadow-sm border" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            @TempData["ErrorMessage"]
        </div>

        <script>
            setTimeout(function () {
                var alertBox = document.getElementById('errorMessage');
                if (alertBox) {
                    // Sử dụng Bootstrap's fade-out
                    alertBox.classList.remove('show');
                    alertBox.classList.add('hide');

                    // Sau khi hiệu ứng fade kết thúc (0.5s), ẩn hẳn
                    setTimeout(function () {
                        alertBox.style.display = 'none';
                    }, 500);
                }
            }, 3000); // 2 giây
        </script>
    }

    <div class="container">
        <h2 class="header-title">Danh Sách Cư Dân</h2>

        <div class="table-container">
            <a asp-action="Create" class="btn-create">Thêm mới</a>
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên Người Dùng</th>
                        <th>Căn Hộ</th>
                        <th>Chung Cư</th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cuDan in Model)
                    {
                        <tr>
                            <td>@cuDan.ID</td>
                            <td>@cuDan.NguoiDung.HoTen</td>
                            <td>@cuDan.CanHo?.MaCan</td>
                            <td>@cuDan.CanHo?.ChungCu?.Ten</td>
                            <td class="action-links">
                                <a asp-action="Edit" asp-route-id="@cuDan.ID" class="edit">Chỉnh sửa</a> |
                                <a asp-action="Delete" asp-route-id="@cuDan.ID" class="delete">Xóa</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>