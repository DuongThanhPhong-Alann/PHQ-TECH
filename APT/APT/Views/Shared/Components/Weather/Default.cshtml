@if (ViewBag.City != null)
{
    var iconUrl = "http://openweathermap.org/img/wn/" + ViewBag.Icon + "@2x.png";
    <div style="display: flex; gap: 16px; align-items: center; line-height: 1.4; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
        <img src="@iconUrl" alt="Weather Icon" style="height: 28px;" />
        <div style="font-weight: bold; font-size: 18px;">🌤 @ViewBag.City</div>
        <div><strong>Nhiệt độ:</strong> @ViewBag.Temp°C</div>
        <div><strong>Cảm giác:</strong> @ViewBag.FeelsLike°C</div>
        <div><strong>Độ ẩm:</strong> @ViewBag.Humidity%</div>
        <div><strong>Trạng thái:</strong> @ViewBag.Description</div>
    </div>
}
